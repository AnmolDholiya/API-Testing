# ── Local Development Configuration ──────────────────────────────────────────
PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/taskdb
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=1h

# ── Docker Compose Configuration (Used inside Docker containers) ─────────────
# In Docker Compose, the backend connects to MongoDB via the service name 'mongodb':
# MONGO_URI=mongodb://mongodb:27017/taskdb
# PORT=5000
# NODE_ENV=production

# ── Frontend Configuration (Optional) ─────────────────────────────────────────
# When empty, frontend uses Nginx reverse proxy on port 5173
# VITE_API_URL=http://localhost:5000
